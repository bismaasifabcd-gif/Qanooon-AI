# Firebase Configuration (frontend — safe to expose, used by Firebase Hosting/Auth/Firestore)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Groq backend URL — the free Render server that holds the Groq key.
# In dev it defaults to http://localhost:5000 if unset.
VITE_API_URL=https://kanoon-ai-backend.onrender.com

# NOTE: The Groq API key is NOT here. It lives on the backend server only
# (set GROQ_API_KEY in Render's dashboard, see render.yaml).

# Google Maps & Places (Find a Lawyer feature)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Custom Search (optional fallback)
VITE_SEARCH_API_KEY=your_google_custom_search_api_key
VITE_SEARCH_ENGINE_ID=your_search_engine_id

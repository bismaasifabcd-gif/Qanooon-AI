# ──────────────────────────────────────────────────────────────
# Qanoon AI — environment variables
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — NEVER commit real keys.
# ──────────────────────────────────────────────────────────────

# Firebase (frontend web config — safe to expose, used by Auth + Firestore)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend API base URL.
# Leave BLANK for production — the app calls the same-origin /api serverless
# functions on Vercel. In local dev an empty value falls back to
# http://localhost:5000. Only set this if you run the backend on a
# separate origin.
VITE_API_URL=

# ──────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — do NOT put this in the frontend .env.
# The Groq API key lives only in the serverless environment:
#   Vercel dashboard → Project → Settings → Environment Variables → GROQ_API_KEY
# Get a free key at https://console.groq.com
# ──────────────────────────────────────────────────────────────
# GROQ_API_KEY=your_groq_api_key   (set in Vercel, never committed)
